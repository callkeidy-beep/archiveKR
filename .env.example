# Newsroom contents remain sample; live Daum connection probe is a separate protected tool.
CONTENT_MAKER_MODE=sample
CONTENT_MAKER_DB=.local/content-maker.sqlite3
CONTENT_MAKER_HOST=127.0.0.1
CONTENT_MAKER_PORT=3100
# Configure the encrypted account/admin password interactively: npm run mail:setup
# Never put plaintext mailbox passwords in source, chat, HTTP fields or command arguments.
# CONTENT_MAKER_MAIL_DIR=.local/mail
# Optional external Fernet master key; generated and stored securely on your server.
# CONTENT_MAKER_ENCRYPTION_KEY=
# Remote HTTPS deployments only: exact allowed server hostname, no URL or port.
# CONTENT_MAKER_TRUSTED_HOSTS=editor.example.com
# Optional Docker localhost HTTP peer: exact inspected bridge gateway only, never public access.
# CONTENT_MAKER_TRUSTED_HTTP_PEERS=
# AI and real mail ingestion are NOT enabled by this feature.
